# 复制为 .env 并填入真实 key（.env 已被 gitignore，不会提交）
# RunningHub（ComfyUI 工作流 API：视频 = MiniMax H3 导演台 ref2va；图片 = QWEN 文生图）
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_WORKFLOW_VIDEO=2098713358475288577
RUNNINGHUB_WORKFLOW_IMAGE=2098715929763995649
# 稳定版出图工作流（可选）：上传 workerflow/QWEN文生图（稳定版）_api.json 到 RunningHub
# 得到新工作流 ID 后，把 WORKFLOW_IMAGE 换成新 ID 并设置负向节点号（稳定版固定为 7）
IMAGE_NEGATIVE_NODE=
# 关键帧图生图工作流（可选，推荐）：上传 workerflow/QWEN图生图（Edit参考版单段）_api.json
# 到 RunningHub 拿工作流 ID 填这里；关键帧生成会把在场资产卡作参考图上传（锁脸）。
# 留空 = 关键帧仍走 WORKFLOW_IMAGE 纯文生图
RUNNINGHUB_WORKFLOW_IMAGE_EDIT=

# LLM（OpenAI 兼容接口；按需选一家，base_url/model/key 必须同源）
# 智谱 GLM：LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4.6
# 结构化输出上限（deepseek-chat 最大 8192；0=不传用供应商默认）
LLM_MAX_TOKENS=8192
# DeepSeek：LLM_BASE_URL=https://api.deepseek.com              LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.6

# 运行数据目录（DB/媒体/日志）
DATA_DIR=./data

# ffmpeg 可执行文件（默认走 PATH）
FFMPEG_PATH=ffmpeg
